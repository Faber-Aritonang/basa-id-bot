# ============================================================
# Basa.id — template konfigurasi lingkungan
# Salin file ini menjadi `.env` lalu isi nilainya.
# JANGAN commit `.env` (sudah ada di .gitignore).
# ============================================================

# --- Platform aktif: console | telegram | whatsapp ---
PLATFORM=console

# --- Database ---
# Dev lokal: SQLite (default). Produksi: ganti ke Postgres, misal:
# postgresql+psycopg://user:password@host:5432/basa
# (driver Postgres: pip install -e '.[postgres]')
DATABASE_URL=sqlite:///data/basa.db

# --- Telegram (dibutuhkan jika PLATFORM=telegram) ---
# Dapatkan token dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=

# --- WhatsApp (dibutuhkan jika PLATFORM=whatsapp) ---
# Kredensial dari Meta for Developers → WhatsApp Cloud API:
#   WHATSAPP_API_TOKEN       = token akses (System User / App token)
#   WHATSAPP_PHONE_NUMBER_ID = ID nomor HP bisnis (bukan nomornya)
#   WHATSAPP_VERIFY_TOKEN    = string bebas untuk verifikasi webhook
#   WHATSAPP_WEBHOOK_PORT    = port webhook lokal (default 8080)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_PORT=8080

# --- Logging ---
LOG_LEVEL=INFO
